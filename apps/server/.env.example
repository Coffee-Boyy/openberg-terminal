# OpenBerg Terminal — Server Environment
# Copy to .env and fill in your values.
# All keys use the OPENBERG_ prefix to match the SettingsConfigDict.

# Finnhub API key for real market data (https://finnhub.io)
OPENBERG_FINNHUB_API_KEY=

# SQLite path for local database (also supports PostgreSQL URLs)
OPENBERG_DATABASE_URL=sqlite:///data/openberg.db

# Data provider: auto = try Yahoo then Finnhub then Mock; mock = demo mode
OPENBERG_DATA_PROVIDER=auto

# Cache TTL for quotes (seconds)
OPENBERG_CACHE_QUOTES_TTL=10

# Cache TTL for historical prices (seconds)
OPENBERG_CACHE_PRICES_TTL=60

# Log level: DEBUG, INFO, WARNING, ERROR
OPENBERG_LOG_LEVEL=INFO
